# OpenKB settings for this Cloudron app. Edit, then restart the app.
# Lines are shell assignments; values with spaces need quotes.

# Enables the AI chat and the semantic (chunk) index. After setting it:
#   cloudron exec -- drush search-api:reset-tracker kb_chunks -y
#OPENAI_API_KEY=

# Heap of the bundled OpenSearch. Upstream recommends 1 GB or more for a real
# install; raise the app's memory limit in the dashboard accordingly.
#OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"

# Memory-mapped index files: faster, but needs vm.max_map_count=262144 on the
# Cloudron host (sysctl). Off by default.
#OPENSEARCH_ALLOW_MMAP=true

# Use an external OpenSearch cluster instead of the bundled one. The bundled
# node is then not started.
#OPENSEARCH_URL=https://user:password@search.example.com

# Override the computed cookie scope (common parent of both domains).
#SESSION_COOKIE_DOMAIN=.example.com
